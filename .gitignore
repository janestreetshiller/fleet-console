# SwiftPM. Package.resolved is committed on purpose: this ships as a signed app,
# so the SwiftTerm revision has to be pinned, not resolved afresh per machine.
/.build/
/.build

# Built app bundle and generated design surfaces
/build/
/dist/
/.release/
/*.zip
/*.dmg

# Local SwiftPM/Xcode state
/.swiftpm/
xcuserdata/
*.xcuserstate

# Credentials and signing material (track only reviewed example templates)
.env
.env.*
!.env.example
*.p8
*.p12
*.pfx
*.key
*.pem

# Runtime state and diagnostic captures may contain private fleet data
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.db
*.log
*.har

# Rust
/rust/target/

# macOS
.DS_Store
.worktrees/

# The seeded design canvas is a build product of docs/design-canvas/*.dc.html
# and canvas.json — re-seed it, do not track two megabytes of editor.
docs/design-canvas/*.html
!docs/design-canvas/*.dc.html
